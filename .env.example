# Inventario y análisis antimalware en SAS Cliente (ClamAV oficial)
SAS_CLAMSCAN_PATH=C:\Program Files\ClamAV\clamscan.exe
SAS_FRESHCLAM_PATH=C:\Program Files\ClamAV\freshclam.exe
SAS_CLAMAV_DATABASE_PATH=C:\ProgramData\ClamAV\database
SAS_SECURITY_SCAN_TIMEOUT_MS=600000

# Motor remoto opcional: sas, rustdesk, hoptodesk o auto. Los proveedores AGPL se ejecutan como procesos separados.
SAS_REMOTE_ENGINE=sas
SAS_RUSTDESK_PATH=C:\Program Files\RustDesk\RustDesk.exe
SAS_HOPTODESK_PATH=C:\Program Files\HopToDesk\HopToDesk.exe

# Análisis seguro de imágenes recibidas por WhatsApp
WHATSAPP_MEDIA_MAX_BYTES=10485760
FISHER_VISION_ENABLED=true
FISHER_VISION_MOCK=false
FISHER_VISION_MODEL=gpt-5.6-terra
